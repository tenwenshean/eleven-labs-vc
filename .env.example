# Copy this file to .env (setup.bat does it for you) and fill in the first two values.
# .env is in .gitignore: never commit your API key.

# Required: https://elevenlabs.io/app/settings/api-keys
API_KEY=

# Required: the voice to speak with. Run "start.bat --voices" to list yours.
# Free accounts can only use the "premade" voices, e.g. Matilda:
VOICE_ID=XrExE9yKIg1WjnnlVkGX

# Recording mode
#   1 = hands-free: starts when you talk, converts when you pause (default)
#   0 = push-to-talk: press SPACE to start and SPACE again to stop
MODE=1

# Microphone. Empty = Windows default mic.
# Use a number from "start.bat --devices" or part of the device name.
INPUT_DEVICE=
# INPUT_DEVICE_NAME=HyperX

# Where the converted voice goes.
# "CABLE Input" sends it to VB-Cable, so call apps can use "CABLE Output" as a mic.
# If VB-Cable is not installed it falls back to your speakers.
OUTPUT_DEVICE_NAME=CABLE Input
# OUTPUT_DEVICE=

# Hands-free tuning. Raise VAD_THRESHOLD (0.02-0.05) if background noise
# keeps triggering it; lower it if quiet speech is missed.
VAD_THRESHOLD=0.01
VAD_SILENCE_DURATION=0.8
VAD_MIN_RECORDING_DURATION=0.3
VAD_PRE_BUFFER_DURATION=0.5

# Audio (defaults are fine for most people)
SAMPLE_RATE=48000
CHANNELS=1
SILENCE_THRESHOLD=0.01
REMOVE_BACKGROUND_NOISE=1
OUTPUT_SAMPLE_RATE=48000
API_SAMPLE_RATE=22050
